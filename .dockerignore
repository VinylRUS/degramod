# Что НЕ попадает в образ на шаге `COPY . .`.
#
# Критично: Dockerfile сначала делает `uv sync --frozen`, который создаёт
# /app/.venv, и только потом копирует исходники. Без этого файла локальный
# .venv с машины разработчика затирает собранное в образе окружение, а вместе
# с ним в прод уезжает каталог data/ с рабочей базой.

# Окружения и кэши
.venv*/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/
.uv-cache/

# Секреты и данные
.env
.env.*
.github_enc_key
data/
*.db
*.db-wal
*.db-shm
*.backup-*.db

# Git и IDE
.git/
.gitignore
.github/
.idea/
.vscode/

# Документация и планы — в рантайме не нужны, но меняются часто и сбивали бы
# кеш слоёв.
*.md
docs/
roadmaps/
