# Пример окружения. Скопируй в .env и заполни значения.
# Сам .env в репозиторий не попадает (см. .gitignore).

# ── Обязательные ────────────────────────────────────────────────────────────

# Токен бота от @BotFather. Без него процесс падает с RuntimeError на старте.
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# TG ID глобальных супер-админов через запятую. Обходят все проверки прав.
ADMIN_IDS=111111111,222222222

# Пароль SU для веб-панели (логин su). Сравнивается с этим значением напрямую,
# в базе не хранится и не хешируется.
WEB_PASSWORD=change-me

# ── Нужны на практике ───────────────────────────────────────────────────────

# Ключ подписи cookie сессий. Без него генерируется случайный при каждом
# старте, и все сессии слетают после рестарта.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ── Необязательные ──────────────────────────────────────────────────────────

# Путь к файлу SQLite. По умолчанию /app/data/shadow_logs.db.
# DB_PATH=/app/data/shadow_logs.db

# Если задан и вебхук успешно установился — режим webhook, иначе long polling.
# WEBHOOK_URL=https://example.com

# Проверяется в заголовке X-Telegram-Bot-Api-Secret-Token. Без переменной
# генерируется случайный на старте.
# WEBHOOK_SECRET=

# Принудительно создаёт chat_settings для перечисленных чатов.
# Формат: -100123:Тег,-100456:Тег2
# CHAT_HASHTAGS=

# База для ссылок в отчётах. По умолчанию захардкожен прод-домен.
# WEB_PUBLIC_URL=https://example.com

# Порт HTTP-сервера. По умолчанию 3000. На Bothost выставляется платформой —
# вручную задавать не нужно.
# PORT=3000

# Прокси, которым можно верить в X-Forwarded-For (через запятую). Пусто —
# не верить никому: заголовок игнорируется и rate-limit логина считается по
# реальному peer.
# TRUSTED_PROXIES=

# Принудительно старый путь миграций: init_db() вместо Alembic.
# v4.11.0: причина прошлых падений найдена и починена (пустая alembic_version
# + отсутствие настоящего fallback), но флаг оставлен — снимать после того,
# как версия с fail-safe отработает на проде и логи покажут, что миграции
# проходят спокойно. Без флага сбой миграций больше не валит старт: бот
# откатится на init_db() и напишет об этом в лог.
# На проде снят 20.08.2026 — миграции идут через Alembic и проходят штатно.
# Ставить 1 только если понадобится принудительно вернуться на init_db().
DB_USE_LEGACY_MIGRATIONS=0

# Ключ шифрования GitHub PAT (Fernet). Если не задан — создаётся файл
# .github_enc_key рядом с БД, права 0600. При потере ключа сохранённые
# токены расшифровать нельзя.
# GITHUB_IDEA_ENC_KEY=

# Срок жизни сессии в секундах. По умолчанию 604800 (7 дней).
# WEB_SESSION_TTL_SECONDS=604800

# Ставить ли cookie с флагом Secure. По умолчанию 1 (только HTTPS).
# Для локальной разработки по http — 0.
# WEB_COOKIE_SECURE=1

# ── Bothost Agent API (v5.1.0) ──────────────────────────────────────────────
# Служебный API хостинга: статистика контейнера, логи, самоперезапуск.
# Все три переменные задаёт платформа Bothost; локально их нет, и это
# нормально — панель покажет «агент недоступен» и продолжит работать.

# Идентификатор контейнера. Без него в сеть не ходим вовсе.
BOT_ID=

# Токен авторизации agent API, уходит в заголовке Authorization: Bearer.
# Принимается также под именем API_TOKEN (приоритет у BOT_API_TOKEN).
BOT_API_TOKEN=

# Публичный адрес агента — вида http://<нода>.bothost.ru (msk1, nl9, ...).
# Нужен, когда внутренний agent:8000 недоступен: если контейнер бота не в
# Docker-сети агента, имя `agent` не резолвится вовсе.
#
# Имя ноды видно в панели Bothost. Проверено 20.08.2026: узел отвечает
#   GET /api/bots/{BOT_ID}/stats -> 401 {"ok":false,"msg":"Unauthorized: missing Bearer token"}
# то есть путь и схема авторизации верные.
#
# Адрес agent.bothost.ru, указанный в документации как внешний, НЕ работает:
# резолвится, но отказывает в соединении на 80, 443 и 8000. Дефолта в коде
# намеренно нет — угаданный адрес выглядел бы рабочим и превращал
# «адрес не настроен» в «агент лежит».
BOTHOST_AGENT_URL=

# ── v5.3.2: ночной CAS/LOLS-свип ──────────────────────────────────────────
# Сколько дней назад юзер должен был писать, чтобы попасть в ночной свип
# (01:00-05:00 МСК, автобан найденных в CAS/LOLS). 0 = свип выключен.
# Дайджест - одна строка в репорт-чат в 05:00 МСК ежедневно.
CAS_SWEEP_SEEN_DAYS=90
